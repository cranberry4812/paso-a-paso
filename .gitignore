# Installed packages (recreated with `npm install`)
node_modules/

# Build output (recreated with `npm run build`)
dist/

# Secrets: never commit these. Only .env.example (with no real values) is allowed.
.env
.env.*
!.env.example

# Supabase local files
supabase/.temp/
supabase/.branches/

# Logs and system files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor settings (except shared recommendations)
.vscode/*
!.vscode/extensions.json
